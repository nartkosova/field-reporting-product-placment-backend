generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  employee
  viewer
}

enum StoreChannel {
  TT
  MT
}

enum StoreCategory {
  A
  B
  C
  D
  E
  F
  G
  W
  WHC
}

enum PhotoType {
  regular_shelf
  secondary_position
  new_product
  sale
  fletushka
  korporative
  staleness
  reward_game
  dimensioning_report
  secondary_position_quarter
  other1
  other2
}

enum Company {
  podravka
  competitor
}

enum ProductCategory {
  A
  B
  C
  D
  E
  F
  G
}

enum RecordType {
  FACINGS
  PRESENCE
}

enum WorkLogStatus {
  planned_work
  vacation
  sick_day
  other
}

enum WorkActivityType {
  ppl
  photo_report
  presence_report
  podravka_facings
  competitor_facings
  store_visit
  other
}

model User {
  userId              Int                  @id @default(autoincrement()) @map("user_id")
  user                String               @db.VarChar(100)
  password            String               @db.VarChar(255)
  role                UserRole?            @default(employee)
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until") @db.Timestamp(0)
  createdAt           DateTime?            @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  competitorFacings   CompetitorFacing[]
  competitorProducts  CompetitorProduct[]
  podravkaFacings     PodravkaFacing[]
  reportPhotos        ReportPhoto[]
  stores              Store[]
  storeVisits         StoreVisit[]
  storeVisitPhotos    StoreVisitPhoto[]
  workLogDays         WorkLogDay[]

  @@map("users")
}

model WorkLogDay {
  workLogDayId        Int                  @id @default(autoincrement()) @map("work_log_day_id")
  userId              Int                  @map("user_id")
  workDate            DateTime             @map("work_date") @db.Date
  status              WorkLogStatus        @default(planned_work)
  plan                String?              @db.Text
  summary             String?              @db.Text
  absenceReason       String?              @map("absence_reason") @db.VarChar(255)
  startKilometers     Decimal?             @map("start_kilometers") @db.Decimal(10, 2)
  endKilometers       Decimal?             @map("end_kilometers") @db.Decimal(10, 2)
  kilometersDriven    Decimal?             @map("kilometers_driven") @db.Decimal(10, 2)
  fuelCost            Decimal?             @map("fuel_cost") @db.Decimal(10, 2)
  fuelLiters          Decimal?             @map("fuel_liters") @db.Decimal(10, 2)
  otherTravelCost     Decimal?             @map("other_travel_cost") @db.Decimal(10, 2)
  checkInAt           DateTime?            @map("check_in_at") @db.Timestamp(0)
  checkOutAt          DateTime?            @map("check_out_at") @db.Timestamp(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamp(0)
  user                User                 @relation(fields: [userId], references: [userId], map: "work_log_days_ibfk_1")
  storeVisits         StoreVisit[]
  activities          WorkLogActivity[]
  cities              WorkLogDayCity[]
  competitorFacings   CompetitorFacing[]
  podravkaFacings     PodravkaFacing[]
  reportPhotos        ReportPhoto[]

  @@unique([userId, workDate], map: "uniq_user_work_date")
  @@index([userId], map: "idx_work_log_days_user_id")
  @@index([workDate], map: "idx_work_log_days_work_date")
  @@map("work_log_days")
}

model WorkLogActivity {
  workLogActivityId   Int                  @id @default(autoincrement()) @map("work_log_activity_id")
  workLogDayId        Int                  @map("work_log_day_id")
  activityType        WorkActivityType     @map("activity_type")
  planned             Boolean              @default(true)
  completed           Boolean              @default(false)
  quantity            Int?
  note                String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamp(0)
  workLogDay          WorkLogDay           @relation(fields: [workLogDayId], references: [workLogDayId], onDelete: Cascade, map: "work_log_activities_ibfk_1")

  @@index([workLogDayId], map: "idx_work_log_activities_day_id")
  @@index([activityType], map: "idx_work_log_activities_type")
  @@map("work_log_activities")
}

model WorkLogDayCity {
  workLogDayCityId    Int                  @id @default(autoincrement()) @map("work_log_day_city_id")
  workLogDayId        Int                  @map("work_log_day_id")
  cityName            String               @map("city_name") @db.VarChar(100)
  visitOrder          Int?                 @map("visit_order")
  note                String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  workLogDay          WorkLogDay           @relation(fields: [workLogDayId], references: [workLogDayId], onDelete: Cascade, map: "work_log_day_cities_ibfk_1")

  @@index([workLogDayId], map: "idx_work_log_day_cities_day_id")
  @@index([cityName], map: "idx_work_log_day_cities_city_name")
  @@map("work_log_day_cities")
}

model StoreVisit {
  storeVisitId        Int                  @id @default(autoincrement()) @map("store_visit_id")
  workLogDayId        Int                  @map("work_log_day_id")
  userId              Int                  @map("user_id")
  storeId             Int                  @map("store_id")
  checkInAt           DateTime             @default(now()) @map("check_in_at") @db.Timestamp(0)
  checkOutAt          DateTime?            @map("check_out_at") @db.Timestamp(0)
  note                String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  workLogDay          WorkLogDay           @relation(fields: [workLogDayId], references: [workLogDayId], onDelete: Cascade, map: "store_visits_ibfk_1")
  user                User                 @relation(fields: [userId], references: [userId], map: "store_visits_ibfk_2")
  store               Store                @relation(fields: [storeId], references: [storeId], map: "store_visits_ibfk_3")
  photos              StoreVisitPhoto[]

  @@index([workLogDayId], map: "idx_store_visits_day_id")
  @@index([userId], map: "idx_store_visits_user_id")
  @@index([storeId], map: "idx_store_visits_store_id")
  @@map("store_visits")
}

model StoreVisitPhoto {
  storeVisitPhotoId   Int                  @id @default(autoincrement()) @map("store_visit_photo_id")
  storeVisitId        Int                  @map("store_visit_id")
  userId              Int                  @map("user_id")
  photoUrl            String               @map("photo_url") @db.VarChar(255)
  publicId            String?              @map("public_id") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  storeVisit          StoreVisit           @relation(fields: [storeVisitId], references: [storeVisitId], onDelete: Cascade, map: "store_visit_photos_ibfk_1")
  user                User                 @relation(fields: [userId], references: [userId], map: "store_visit_photos_ibfk_2")

  @@index([storeVisitId], map: "idx_store_visit_photos_visit_id")
  @@map("store_visit_photos")
}

model Store {
  storeId             Int                  @id @default(autoincrement()) @map("store_id")
  storeName           String               @map("store_name") @db.VarChar(255)
  storeCode           String               @unique(map: "store_code") @map("store_code") @db.VarChar(50)
  storeChannel        StoreChannel         @map("store_channel")
  storeCategory       StoreCategory        @map("store_category")
  userId              Int?                 @map("user_id")
  salesRep            String               @map("sales_rep") @db.VarChar(100)
  location            String               @db.VarChar(100)
  createdAt           DateTime?            @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  user                User?                @relation(fields: [userId], references: [userId], map: "stores_ibfk_1")
  storeVisits         StoreVisit[]
  competitorFacings   CompetitorFacing[]
  podravkaFacings     PodravkaFacing[]
  reportPhotos        ReportPhoto[]

  @@index([userId], map: "idx_user_id")
  @@index([userId, storeCategory], map: "idx_user_category")
  @@map("stores")
}

model ReportPhoto {
  photoId             Int                  @id @default(autoincrement()) @map("photo_id")
  photoUrl            String               @map("photo_url") @db.VarChar(255)
  category            String               @db.VarChar(255)
  photoType           PhotoType            @map("photo_type")
  company             Company
  photoDescription    String?              @map("photo_description") @db.VarChar(250)
  userId              Int                  @map("user_id")
  storeId             Int                  @map("store_id")
  workLogDayId        Int?                 @map("work_log_day_id")
  createdAt           DateTime             @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  user                User                 @relation(fields: [userId], references: [userId], map: "report_photos_ibfk_1")
  store               Store                @relation(fields: [storeId], references: [storeId], map: "report_photos_ibfk_2")
  workLogDay          WorkLogDay?          @relation(fields: [workLogDayId], references: [workLogDayId], map: "report_photos_ibfk_3")

  @@index([userId], map: "user_id")
  @@index([storeId], map: "store_id")
  @@index([workLogDayId], map: "idx_report_photos_work_log_day_id")
  @@map("report_photos")
}

model ProductRanking {
  id                  Int                  @id @default(autoincrement())
  productId           Int                  @map("product_id")
  year                Int
  totalRank           Int?                 @map("total_rank")
  categoryRank        Int?                 @map("category_rank")
  salesLastYear       Float?               @map("sales_last_year")
  categorySalesShare  Decimal?             @map("category_sales_share") @db.Decimal(6, 4)
  createdAt           DateTime?            @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  product             PodravkaProduct      @relation(fields: [productId], references: [productId], map: "product_rankings_ibfk_1")

  @@index([productId], map: "product_id")
  @@map("product_rankings")
}

model PodravkaProduct {
  productId           Int                  @id @default(autoincrement()) @map("product_id")
  businessUnit        String               @map("business_unit") @db.VarChar(100)
  category            String               @db.VarChar(100)
  name                String               @db.VarChar(255)
  podravkaCode        String               @unique(map: "podravka_code") @map("podravka_code") @db.VarChar(50)
  elkosCode           Int?                 @map("elkos_code")
  productCategory     ProductCategory      @map("product_category")
  weight              Float?
  createdAt           DateTime?            @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  facings             PodravkaFacing[]
  rankings            ProductRanking[]

  @@map("podravka_products")
}

model PodravkaFacing {
  podravkaFacingsId   Int                  @id @default(autoincrement()) @map("podravka_facings_id")
  userId              Int                  @map("user_id")
  storeId             Int                  @map("store_id")
  productId           Int                  @map("product_id")
  workLogDayId        Int?                 @map("work_log_day_id")
  category            String               @db.VarChar(255)
  facingsCount        Int                  @map("facings_count")
  batchId             String               @map("batch_id") @db.VarChar(45)
  createdAt           DateTime             @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  isListed            Boolean?             @default(true) @map("is_listed") @db.TinyInt
  recordType          RecordType?          @default(FACINGS) @map("record_type")
  user                User                 @relation(fields: [userId], references: [userId], map: "podravka_facings_ibfk_1")
  store               Store                @relation(fields: [storeId], references: [storeId], map: "podravka_facings_ibfk_2")
  product             PodravkaProduct      @relation(fields: [productId], references: [productId], map: "podravka_facings_ibfk_3")
  workLogDay          WorkLogDay?          @relation(fields: [workLogDayId], references: [workLogDayId], map: "podravka_facings_ibfk_4")

  @@index([userId], map: "user_id")
  @@index([storeId], map: "store_id")
  @@index([productId], map: "product_id")
  @@index([workLogDayId], map: "idx_podravka_facings_work_log_day_id")
  @@map("podravka_facings")
}

model CompetitorProduct {
  competitorProductId Int                  @id @default(autoincrement()) @map("competitor_product_id")
  competitorId        Int                  @map("competitor_id")
  name                String               @db.VarChar(255)
  category            String               @db.VarChar(100)
  weight              Float?
  createdBy           Int?                 @map("created_by")
  createdAt           DateTime?            @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  competitor          CompetitorBrand      @relation(fields: [competitorId], references: [competitorId], map: "competitor_products_ibfk_1")
  creator             User?                @relation(fields: [createdBy], references: [userId], map: "competitor_products_ibfk_2")

  @@index([competitorId], map: "competitor_id")
  @@index([createdBy], map: "created_by")
  @@map("competitor_products")
}

model CompetitorFacing {
  id                  Int                  @id @default(autoincrement())
  userId              Int                  @map("user_id")
  storeId             Int                  @map("store_id")
  competitorId        Int                  @map("competitor_id")
  workLogDayId        Int?                 @map("work_log_day_id")
  category            String               @db.VarChar(45)
  facingsCount        Int                  @map("facings_count")
  batchId             String               @map("batch_id") @db.VarChar(45)
  createdAt           DateTime             @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  user                User                 @relation(fields: [userId], references: [userId], map: "competitor_facings_ibfk_1")
  store               Store                @relation(fields: [storeId], references: [storeId], map: "competitor_facings_ibfk_2")
  competitor          CompetitorBrand      @relation(fields: [competitorId], references: [competitorId], map: "competitor_facings_ibfk_3")
  workLogDay          WorkLogDay?          @relation(fields: [workLogDayId], references: [workLogDayId], map: "competitor_facings_ibfk_4")

  @@index([userId], map: "user_id")
  @@index([storeId], map: "store_id")
  @@index([competitorId], map: "competitor_id")
  @@index([workLogDayId], map: "idx_competitor_facings_work_log_day_id")
  @@map("competitor_facings")
}

model CompetitorBrand {
  competitorId        Int                        @id @default(autoincrement()) @map("competitor_id")
  brandName           String                     @unique(map: "brand_name_UNIQUE") @map("brand_name") @db.VarChar(255)
  createdAt           DateTime?                  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(0)
  categories          CompetitorBrandCategory[]
  facings             CompetitorFacing[]
  products            CompetitorProduct[]

  @@map("competitor_brands")
}

model CompetitorBrandCategory {
  id                  Int                  @id @default(autoincrement())
  competitorId        Int                  @map("competitor_id")
  category            String               @db.VarChar(100)
  competitor          CompetitorBrand      @relation(fields: [competitorId], references: [competitorId], onDelete: Cascade, map: "competitor_brand_categories_ibfk_1")

  @@index([competitorId], map: "competitor_id")
  @@map("competitor_brand_categories")
}
