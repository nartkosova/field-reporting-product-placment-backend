PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app123
DB_NAME=field_report

# Prisma uses a single connection string.
# Example: mysql://app:app123@localhost:3306/field_report
DATABASE_URL="mysql://app:app123@localhost:3306/field_report"

JWT_SECRET=change_me
GEMINI_API_KEY=
OPENAI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRES_IN=12h
